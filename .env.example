# Database
# Port 5433 (not 5432) is used because 5432 is commonly occupied by a native
# Postgres install. If your machine has nothing on 5432, you can safely use
# it instead - just keep docker-compose.yml's port mapping consistent.
DATABASE_URL=postgresql://captrack:captrack@localhost:5433/captrack
DATABASE_URL_TEST=postgresql://captrack:captrack@localhost:5433/captrack_test

# Server
PORT=3001
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-this
COOKIE_NAME=captrack_session

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
OAUTH_REDIRECT_BASE_URL=http://localhost:3001

# Client
VITE_API_BASE_URL=http://localhost:3001
CLIENT_ORIGIN=http://localhost:5173
