{
  "name": "captrack",
  "version": "0.1.0",
  "description": "Personal expense tracker with real-time budget alerts",
  "type": "module",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "test": "npm run test -w server",
    "test:watch": "npm run test:watch -w server",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:up": "docker-compose up -d db",
    "db:down": "docker-compose down",
    "db:migrate": "npm run migrate -w server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.70.1"
  }
}
